{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "new-gpedmonton",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "gpedmonton.org",
      "custom_domain": true
    },
    {
      "pattern": "www.gpedmonton.org",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application"
  }
}
